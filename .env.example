# Copy this file to .env and fill in real values. NEVER commit .env.

# Required: token from @BotFather (looks like 123456789:AAxxxxxxxx...)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# LOCAL (default, free, no credentials) or TWILIO (optional external lookups)
LOOKUP_PROVIDER=LOCAL

# Default country used to parse numbers without a + prefix (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=IN

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# Per-user rate limit
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# HTTP behaviour for external providers
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2

# --- Only needed when LOOKUP_PROVIDER=TWILIO ---
TWILIO_ACCOUNT_SID=
# Option A: API key (recommended)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Option B: account auth token (used only if no API key is set)
TWILIO_AUTH_TOKEN=
# Opt-in: request line type / carrier (may be chargeable - check Twilio pricing)
TWILIO_ENABLE_LINE_TYPE=false
